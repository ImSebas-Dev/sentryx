# ══════════════════════════════════════════════════════════
#  Sentryx v2 — Variables de entorno
#  Copiar a .env (scripts/dev/setup.sh lo genera con estos valores).
#  Los valores de este archivo son SOLO PARA DESARROLLO: en producción
#  cambiar todas las claves, contraseñas y el salt.
# ══════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────
ENVIRONMENT=development
DJANGO_SECRET_KEY=sentryx-dev-secret-key-2026-cambiar-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=sentryx
POSTGRES_USER=sentryx
POSTGRES_PASSWORD=sentryx123
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────────────────
REDIS_PASSWORD=redis123
REDIS_URL=redis://:redis123@redis:6379/0
CELERY_BROKER_URL=redis://:redis123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis123@redis:6379/1

# ── JWT ───────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ── Verificación en dos pasos (TOTP) ──────────────────────
# Clave para cifrar los secretos TOTP en la base de datos. Si cambia, los
# usuarios con 2FA deben volver a activarlo (o un admin restablecerlo).
MFA_ENCRYPTION_KEY=sentryx-dev-mfa-key-2026-cambiar-en-produccion
# True: los administradores sin 2FA solo pueden entrar a configurarlo.
MFA_REQUIRED_FOR_ADMINS=False
# Límite de peticiones a /auth/mfa/ por IP o usuario
THROTTLE_MFA_RATE=10/min

# ── Motor ML ──────────────────────────────────────────────
ML_ENGINE_URL=http://ml_engine:8001
ML_ENGINE_API_KEY=mlkey123
ML_THRESHOLD_SUSPICIOUS=40
ML_THRESHOLD_PHISHING=70
ML_THRESHOLD_CRITICAL=85
ML_WEIGHT_HEADERS=0.35
ML_WEIGHT_CONTENT=0.40
ML_WEIGHT_URLS=0.25
# Correcciones pendientes mínimas para reentrenar (manual y mensual)
ML_RETRAIN_MIN_SAMPLES=5

# ── Privacidad (Ley 1581/2012) ────────────────────────────
PSEUDONYMIZATION_SALT=salt-unico-sentryx-2026
# Alertas resueltas o falsos positivos
DATA_RETENTION_EVENT_LOGS_DAYS=90
# Log de auditoría
DATA_RETENTION_INCIDENTS_DAYS=365

# ── CORS / Frontend ───────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
FRONTEND_URL=http://localhost

# ── Correo transaccional ──────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sentryx.com

# ── django-axes ───────────────────────────────────────────
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# ── Threat Intelligence ───────────────────────────────────
PHISHTANK_API_KEY=
PHISHTANK_SYNC_INTERVAL_HOURS=1
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
OPENPHISH_SYNC_INTERVAL_HOURS=6
