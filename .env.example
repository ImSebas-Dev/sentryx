# ══════════════════════════════════════════════════════════
#  Sentryx v2 — Variables de entorno
#  No copies este archivo a mano: genera tu .env con secretos aleatorios con
#    python scripts/dev/generate_env.py                (desarrollo)
#    python scripts/dev/generate_env.py --production --domain tu.dominio
#  Las variables marcadas <generado> quedan vacías aquí a propósito: un valor
#  publicado en el repositorio no es secreto. Ver docs/seguridad.md.
# ══════════════════════════════════════════════════════════

# ── Django ────────────────────────────────────────────────
ENVIRONMENT=development
# <generado>
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_SETTINGS_MODULE=config.settings.development

# ── PostgreSQL ────────────────────────────────────────────
POSTGRES_DB=sentryx
POSTGRES_USER=sentryx
# <generado>
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# ── Redis / Celery ────────────────────────────────────────
# <generado> (las tres URLs llevan la misma contraseña)
REDIS_PASSWORD=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=

# ── JWT ───────────────────────────────────────────────────
JWT_ALGORITHM=HS256
# El access token vive solo en memoria del navegador: que dure poco
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# ── Verificación en dos pasos (TOTP) ──────────────────────
# Clave para cifrar los secretos TOTP en la base de datos. Si cambia, los
# usuarios con 2FA deben volver a activarlo (o un admin restablecerlo).
# <generado>
MFA_ENCRYPTION_KEY=
# True: los administradores sin 2FA solo pueden entrar a configurarlo.
# En producción vale True por defecto.
MFA_REQUIRED_FOR_ADMINS=False
# Límite de peticiones a /auth/mfa/ por IP o usuario
THROTTLE_MFA_RATE=10/min

# ── Motor ML ──────────────────────────────────────────────
ML_ENGINE_URL=http://ml_engine:8001
# <generado> El motor ML rechaza todas las peticiones si está vacía
ML_ENGINE_API_KEY=
ML_THRESHOLD_SUSPICIOUS=40
ML_THRESHOLD_PHISHING=70
ML_THRESHOLD_CRITICAL=85
ML_WEIGHT_HEADERS=0.35
ML_WEIGHT_CONTENT=0.40
ML_WEIGHT_URLS=0.25
# Correcciones pendientes mínimas para reentrenar (manual y mensual)
ML_RETRAIN_MIN_SAMPLES=5

# ── Privacidad (Ley 1581/2012) ────────────────────────────
# <generado>
PSEUDONYMIZATION_SALT=
# Alertas resueltas o falsos positivos
DATA_RETENTION_EVENT_LOGS_DAYS=90
# Log de auditoría
DATA_RETENTION_INCIDENTS_DAYS=365

# ── CORS / Frontend / cookies ─────────────────────────────
# Solo orígenes explícitos; en producción, solo https://
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost
CSRF_TRUSTED_ORIGINS=
FRONTEND_URL=http://localhost
# True con HTTPS: las cookies (sesión, CSRF, refresh) solo viajan cifradas
COOKIE_SECURE=False

# ── Panel /admin/ de Django ───────────────────────────────
# En producción usa una ruta difícil de adivinar o apágalo
DJANGO_ADMIN_ENABLED=True
DJANGO_ADMIN_URL=admin/

# ── Enlaces de los correos de cuenta ──────────────────────
EMAIL_VERIFICATION_TIMEOUT_HOURS=24
PASSWORD_RESET_TIMEOUT_MINUTES=30
AUTH_EMAIL_COOLDOWN_SECONDS=60

# ── Límite de peticiones (DRF) ────────────────────────────
THROTTLE_ANON_RATE=300/hour
THROTTLE_USER_RATE=1000/hour
THROTTLE_AUTH_LOGIN_RATE=10/min
THROTTLE_AUTH_REGISTER_RATE=10/hour
THROTTLE_AUTH_EMAIL_RATE=5/hour
THROTTLE_ANALYZE_RATE=300/hour

# ── Correo transaccional ──────────────────────────────────
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@sentryx.com

# ── Escudo de pagos ───────────────────────────────────────
# <generado> HMAC de cuentas bancarias. Sin ella el escudo funciona, pero no
# registra ni compara números de cuenta.
PAYMENT_SHIELD_SECRET=
# Tamaño máximo en MB de cada adjunto .xml o .zip de factura
PAYMENT_SHIELD_MAX_ATTACHMENT_MB=5
# Bancos adicionales separados por comas, además de la lista de services.py
PAYMENT_SHIELD_EXTRA_BANKS=

# ── Control de cuatro ojos ────────────────────────────────
# La política se edita desde la interfaz; esto solo fija valores por defecto.
# Minutos que tiene un aprobador para decidir antes de que la solicitud venza
FOUR_EYES_DEFAULT_EXPIRY_MINUTES=240
# Cada cuántos minutos corre la tarea que vence las solicitudes
FOUR_EYES_EXPIRY_CHECK_MINUTES=5
# Límite de consultas de estado por usuario (polling de la extensión)
THROTTLE_FOUR_EYES_STATUS_RATE=360/hour

# ── Respuesta a incidentes ────────────────────────────────
# Pon aquí la URL oficial vigente del CAI Virtual de la Policía Nacional.
# Si queda vacía, el asistente y el PDF indican cómo buscarlo en el sitio oficial.
CAI_VIRTUAL_URL=

# ── Red de alerta entre pymes ─────────────────────────────
# Déjalo vacío para desactivar la red. Con el hub local: http://community_hub:8100
COMMUNITY_HUB_URL=
# Key de este nodo: la entrega el hub una sola vez cuando el operador lo aprueba
COMMUNITY_NODE_API_KEY=
# Debe ser la misma en todos los nodos de la red; genera una clave larga aleatoria
COMMUNITY_NETWORK_KEY=
# Cada cuántos minutos se envían indicadores y se descarga el feed
COMMUNITY_SYNC_MINUTES=15

# ── Hub de la red (solo con docker compose --profile hub) ─
# Número mínimo de nodos para que un indicador aparezca en el feed
COMMUNITY_K_ANONYMITY=2
# Clave del panel del operador. Vacía: el panel y la aprobación de nodos quedan cerrados
COMMUNITY_HUB_OPERATOR_KEY=
# Reportes máximos por nodo y por día
COMMUNITY_DAILY_LIMIT=1000
# <generado> Contraseña de la base de datos propia del hub
COMMUNITY_DB_PASSWORD=

# ── django-axes ───────────────────────────────────────────
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1

# ── Threat Intelligence ───────────────────────────────────
PHISHTANK_API_KEY=
PHISHTANK_SYNC_INTERVAL_HOURS=1
OPENPHISH_FEED_URL=https://openphish.com/feed.txt
OPENPHISH_SYNC_INTERVAL_HOURS=6
